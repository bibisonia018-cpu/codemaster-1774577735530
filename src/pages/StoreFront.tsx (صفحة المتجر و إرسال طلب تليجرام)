import React, { useState, useEffect } from 'react';
import { useParams } from 'react-router-dom';
import { db } from '../firebase';
import { collection, query, where, onSnapshot, doc, getDoc, addDoc } from 'firebase/firestore';

export default function StoreFront() {
  const { vendorId } = useParams();
  const [products, setProducts] = useState<any[]>([]);
  const [vendor, setVendor] = useState<any>(null);
  const [orderForm, setOrderForm] = useState({ name: '', phone: '', address: '' });
  const [selectedProduct, setSelectedProduct] = useState<any>(null);

  useEffect(() => {
    if (!vendorId) return;
    
    // جلب معلومات التاجر
    getDoc(doc(db, 'vendors', vendorId)).then(s => setVendor(s.data()));

    // جلب منتجات التاجر في الوقت الفعلي
    const q = query(collection(db, 'products'), where('vendorId', '==', vendorId));
    const unsub = onSnapshot(q, (snap) => {
      setProducts(snap.docs.map(doc => ({ id: doc.id, ...doc.data() })));
    });
    return () => unsub();
  }, [vendorId]);

  const handleOrder = async (e: React.FormEvent) => {
    e.preventDefault();
    if (!vendor || !selectedProduct) return;

    const message = `
🔔 *طلب جديد من متجرك!*
📦 المنتج: ${selectedProduct.name}
💰 السعر: ${selectedProduct.price} دج
👤 الزبون: ${orderForm.name}
📞 الهاتف: ${orderForm.phone}
📍 العنوان: ${orderForm.address}
    `;

    try {
      // إرسال الرسالة إلى تليجرام التاجر
      await fetch(`https://api.telegram.org/bot${vendor.telegramBotToken}/sendMessage`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          chat_id: vendor.telegramChatId,
          text: message,
          parse_mode: 'Markdown'
        })
      });

      // حفظ الطلب في قاعدة البيانات للتوثيق
      await addDoc(collection(db, 'orders'), {
        ...orderForm,
        productName: selectedProduct.name,
        vendorId,
        createdAt: new Date()
      });

      alert('تم إرسال طلبك بنجاح! سيتواصل معك التاجر قريباً.');
      setSelectedProduct(null);
    } catch (error) {
      alert('حدث خطأ أثناء إرسال الطلب.');
    }
  };

  return (
    <div>
      <h1 className="text-2xl font-bold mb-6">متجر: {vendor?.shopName}</h1>
      <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        {products.map(p => (
          <div key={p.id} className="bg-white p-4 rounded-lg shadow">
            <img src={p.image} className="w-full h-48 object-cover rounded mb-4" />
            <h3 className="font-bold">{p.name}</h3>
            <p className="text-green-600 font-bold">{p.price} دج</p>
            <button 
              onClick={() => setSelectedProduct(p)}
              className="w-full mt-4 bg-blue-600 text-white py-2 rounded">اطلب الآن</button>
          </div>
        ))}
      </div>

      {selectedProduct && (
        <div className="fixed inset-0 bg-black/50 flex items-center justify-center p-4">
          <form onSubmit={handleOrder} className="bg-white p-6 rounded-xl max-w-md w-full">
            <h2 className="text-xl font-bold mb-4">تأكيد الطلب: {selectedProduct.name}</h2>
            <input required placeholder="الاسم الكامل" className="w-full border p-2 mb-3 rounded" 
              onChange={e => setOrderForm({...orderForm, name: e.target.value})} />
            <input required placeholder="رقم الهاتف" className="w-full border p-2 mb-3 rounded" 
              onChange={e => setOrderForm({...orderForm, phone: e.target.value})} />
            <textarea required placeholder="العنوان بالتفصيل" className="w-full border p-2 mb-3 rounded" 
              onChange={e => setOrderForm({...orderForm, address: e.target.value})} />
            <div className="flex gap-2">
              <button type="submit" className="flex-1 bg-green-600 text-white py-2 rounded">تأكيد الطلب عبر تليجرام</button>
              <button type="button" onClick={() => setSelectedProduct(null)} className="flex-1 bg-gray-200 py-2 rounded">إلغاء</button>
            </div>
          </form>
        </div>
      )}
    </div>
  );
}